# Copy to .env and fill in. Never commit .env.

# Required: LLM extraction. Pick a provider: gemini (free tier) or anthropic
LLM_PROVIDER=gemini

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: LLM prices in USD per million tokens, from your provider's pricing page.
# Used only to show cost per run in `status`; leave at 0 on a free tier.
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# Optional: Apollo (everything works without it). On the free plan it gives company size; founder email
# lookup needs a paid plan, and seedreach stops asking for it after the first refusal in a run.
APOLLO_API_KEY=
# With an Apollo key: skip companies with more than this many employees, before any LLM call (0 = off).
MAX_EMPLOYEES=100
# Draft to {first}@domain guesses with no evidence? Most bounce or go unread, so off by default.
ALLOW_GUESSED_EMAILS=0
# Generic inboxes (hello@, info@, contact@, team@): no_founder (default) drafts to them only when the site
# names no founder; when it does, the company is listed under "Needs a contact" with a LinkedIn link to the
# founder. always: draft to them anyway. never: never. founders@ always counts as the founders' own.
GENERIC_INBOX=no_founder
# Skip companies that clearly don't sell software (hardware makers, services such as clinics or laundry).
# When the model isn't sure, the company is kept. 0 keeps them all.
SKIP_NON_SOFTWARE=1

# Optional: a short summary after each `run` ("3 new drafts: A, B, C · 2 skipped").
# Company names and counts only, never addresses or draft text. Leave empty for no message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Gmail OAuth files (relative paths resolve against the project folder)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Storage and behaviour
DB_PATH=outreach.db
HTTP_TIMEOUT=15
HN_LOOKBACK_DAYS=62
LAUNCHHN_LOOKBACK_DAYS=120
YC_MAX_TEAM_SIZE=25
# Only YC companies listing one of these regions, comma-separated (YC's own names, e.g. India,Remote).
# Leave empty for every region.
YC_REGIONS=
# Rank leads by region, most wanted first (e.g. India,Remote). Nothing is dropped; empty means no ranking.
PREFER_REGIONS=
LOG_LEVEL=INFO

# Read the company's public Greenhouse/Lever/Ashby job board and name an open engineering internship in the draft
CHECK_JOB_BOARDS=1
# Don't name an internship first posted more than this many days ago (0: no limit)
MAX_ROLE_AGE_DAYS=60

# Servers and CI (for example GitHub Actions): never open a browser for Gmail sign-in; fail fast instead
HEADLESS=0
# Browser identity used when reading company sites. Leave commented out to use the default (recent Chrome)
# USER_AGENT=
